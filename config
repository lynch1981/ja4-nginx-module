ngx_addon_name=ngx_http_ssl_ja4_module

ngx_ja4_shared_srcs="$ngx_addon_dir/src/ngx_ssl_ja4.c $ngx_addon_dir/src/ngx_http_ja4t.c $ngx_addon_dir/src/ngx_ssl_ja4_client_hello.c"

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_ssl_ja4_module
    ngx_module_srcs="$ngx_addon_dir/src/ngx_http_ssl_ja4_module.c $ngx_ja4_shared_srcs"
    . auto/module

    if [ "$STREAM" != NO ]; then
        ngx_module_type=STREAM
        ngx_module_name=ngx_stream_ssl_ja4_module
        ngx_module_srcs="$ngx_addon_dir/src/ngx_stream_ssl_ja4_module.c $ngx_ja4_shared_srcs"
        . auto/module
    fi
else
    HTTP_MODULES="$HTTP_MODULES ngx_http_ssl_ja4_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/src/ngx_http_ssl_ja4_module.c $ngx_ja4_shared_srcs"

    if [ "$STREAM" != NO ]; then
        STREAM_MODULES="$STREAM_MODULES ngx_stream_ssl_ja4_module"
        NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/src/ngx_stream_ssl_ja4_module.c"
    fi
fi
